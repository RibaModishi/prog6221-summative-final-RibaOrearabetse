<Window x:Class="CybersecurityAwarenessBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Chat">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatStack" Margin="10"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Task Assistant">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Add New Task" Margin="10">
                        <StackPanel>
                            <TextBox x:Name="TaskTitleBox" Margin="5" Text="Title"/>
                            <TextBox x:Name="TaskDescBox" Margin="5" Text="Description"/>
                            <DatePicker x:Name="TaskReminderDate" Margin="5"/>
                            <Button Content="Add Task" Click="AddTask_Click" Margin="5"/>
                        </StackPanel>
                    </GroupBox>

                    <ListView x:Name="TaskListView" Grid.Row="1" Margin="10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Status" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="150"/>
                                <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="250"/>
                                <GridViewColumn Header="Reminder" DisplayMemberBinding="{Binding ReminderDate}" Width="150"/>
                                <GridViewColumn Header="Actions" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete" Click="DeleteTask_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Mini Game">
                <StackPanel Margin="10">
                    <TextBlock Text="Cybersecurity Quiz" FontSize="16" FontWeight="Bold" Margin="5"/>
                    <TextBlock x:Name="QuizQuestion" Margin="5" TextWrapping="Wrap"/>
                    <StackPanel x:Name="QuizOptions" Margin="10"/>
                    <Button Content="Next Question" x:Name="NextQuizButton" Click="NextQuizQuestion_Click" Margin="5"/>
                    <TextBlock x:Name="QuizResult" Margin="5" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="UserInputBox" Width="600" Height="30" Margin="0,0,10,0" KeyDown="UserInputBox_KeyDown"/>
            <Button Content="Send" Width="100" Height="30" Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>